# ==============================================================================
# PDF DOCUMENT MANAGEMENT PLATFORM — ENVIRONMENT CONFIGURATION SCHEMA
# Copy this file to .env and replace placeholders with your local environment values.
# NEVER commit raw secrets or production credentials to version control.
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=django-insecure-replace-with-a-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com

# Database Configuration
# In production on Render, if you create a PostgreSQL instance, set DATABASE_URL:
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Alternatively, set DB_ENGINE=sqlite or DB_ENGINE=mysql:
DB_ENGINE=sqlite
MYSQL_DATABASE=pdf_platform_db
MYSQL_USER=pdf_user
MYSQL_PASSWORD=pdf_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root_password

# Authentication & JWT Configuration
# In production across Vercel & Render, set JWT_COOKIE_SECURE=True and JWT_COOKIE_SAMESITE=None
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# Session & CSRF Cookie Configuration (Set to Secure=True and None in cross-origin production)
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax

# CORS & CSRF Configuration (Comma-separated origins, e.g. https://your-project.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Document Storage & Ingestion
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=50

# Client Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api

# ==============================================================================
# PDF DOCUMENT MANAGEMENT PLATFORM — ENVIRONMENT CONFIGURATION SCHEMA
# Copy this file to .env and replace placeholders with your local environment values.
# NEVER commit raw secrets or production credentials to version control.
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=django-insecure-replace-with-a-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (MySQL / fallback to SQLite when DB_ENGINE=sqlite)
DB_ENGINE=mysql
MYSQL_DATABASE=pdf_platform_db
MYSQL_USER=pdf_user
MYSQL_PASSWORD=pdf_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root_password

# Authentication & JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# Document Storage & Ingestion
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=50

# Client Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api
